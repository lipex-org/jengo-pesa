{
  "name": "jengo/pesa",
  "description": "Unified multi-gateway payment processing subsystem for CodeIgniter 4 and the Jengo Framework with M-Pesa Daraja 3.0, Pesapal v3, Stripe, and Flutterwave support.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Ian Ochieng",
      "email": "ochiengian383@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.7",
    "jengo/base": "^1.1",
    "jengo/queues": "^0.1"
  },
  "suggest": {
    "jengo/broadcasting": "Required for real-time WebSocket payment notifications to the frontend"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Jengo\\Pesa\\": "src/"
    },
    "files": [
      "src/Helpers/pesa_helper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Tests\\Support\\": "tests/_support/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit --no-coverage --colors=always"
  }
}
